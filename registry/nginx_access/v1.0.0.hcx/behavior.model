signatures:
- id: http_brute_force
  trigger_action: authentication.failure
  window_secs: 60
  threshold: 3
  escalate_to:
    behavior_class: credential_attack
    risk: Critical
- id: http_scan
  trigger_action: resource.missing
  window_secs: 30
  threshold: 5
  escalate_to:
    behavior_class: reconnaissance
    risk: High
